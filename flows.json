    {
        "id": "cd084ae7ac860f16",
        "type": "function",
        "z": "cb07a1e6f2dfa23b",
        "name": "verify device",
        "func": "// Device not found\nif (msg.payload == null) {\n\n    msg.payload = {\n        status: \"Unauthorized Device\",\n        deviceID: flow.get(\"telemetry\").deviceID,\n        verifiedAt: new Date()\n    };\n\n    return [null, msg];\n}\n\n// Restore original telemetry\nlet telemetry = flow.get(\"telemetry\");\n\n// Add verification timestamp\ntelemetry.timestamp = new Date();\n\n// Pass telemetry to MongoDB Insert\nmsg.payload = telemetry;\n\nreturn [msg, null];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
